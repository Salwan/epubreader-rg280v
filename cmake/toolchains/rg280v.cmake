set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR mipsel)
if(NOT DEFINED ENV{OD_SDK})
    message(FATAL_ERROR "Set OD_SDK to the project-local pinned GCW0 SDK")
endif()
file(REAL_PATH "$ENV{OD_SDK}" OD_SDK)
set(CMAKE_CXX_COMPILER "${OD_SDK}/bin/mipsel-linux-g++")
set(CMAKE_STRIP "${OD_SDK}/bin/mipsel-linux-strip")
set(CMAKE_SYSROOT "${OD_SDK}/mipsel-gcw0-linux-uclibc/sysroot")
set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(ENV{PKG_CONFIG_SYSROOT_DIR} "${CMAKE_SYSROOT}")
set(ENV{PKG_CONFIG_LIBDIR} "${CMAKE_SYSROOT}/usr/lib/pkgconfig:${CMAKE_SYSROOT}/usr/share/pkgconfig")
set(ENV{PKG_CONFIG_PATH} "")
file(REAL_PATH "${CMAKE_CURRENT_LIST_DIR}/../.." PROJECT_ROOT)
set(CMAKE_CXX_FLAGS_INIT "-march=mips32r2 -mtune=mips32r2 -mhard-float -ffile-prefix-map=${PROJECT_ROOT}=.")
set(EPUBREADER_DEVICE ON CACHE BOOL "OpenDingux build" FORCE)
